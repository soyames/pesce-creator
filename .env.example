# Pesce Studio — variables d'environnement (Vercel)
# Copier dans Vercel → Settings → Environment Variables, puis redéployer.

# Token du bot @PesceStudioBot (BotFather)
TELEGRAM_PESCE_BOT_TOKEN=

# Secret du webhook (à déclarer aussi via setWebhook secret_token).
# Sans lui le webhook fonctionne encore mais accepte tout POST (avertissement dans les logs).
TELEGRAM_PESCE_STUDIO_WEBHOOK_SECRET=

# Base de données PostgreSQL/Neon — DATABASE_URL est fournie automatiquement par
# l'intégration Vercel Neon ; les variables PG* servent de repli (ex. exécution locale).
DATABASE_URL=
# PGHOST=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Identifiants Telegram de la créatrice (liste séparée par des virgules).
# Si vide : personne n'est créatrice → le studio reste masqué, l'app publique fonctionne normalement.
PESCE_CREATOR_TELEGRAM_USER_IDS=
# Ancien nom (singulier, un seul identifiant) — conservé en repli, à déprécier.
# PESCE_CREATOR_TELEGRAM_USER_ID=

# Telegraph (articles telegra.ph) — optionnel. À obtenir via « Configurer Telegraph » dans le studio.
TELEGRAPH_ACCESS_TOKEN=

# Secret de signature des URLs média /api/media — optionnel (repli sur le token du bot).
# PESCE_MEDIA_SIGNING_SECRET=

# Studio créatrice web (/studio) — connexion par mot de passe.
# Empreinte scrypt UNIQUEMENT (jamais le mot de passe). À produire localement avec :
#   cd app/frontend && node scripts/generate-studio-password-hash.mjs
# puis à coller dans Vercel (Production, type Secret) et redéployer.
# Sans cette variable, seule la connexion Google est proposée.
PESCE_STUDIO_PASSWORD_HASH=

# Adresses autorisées sur /studio (séparées par des virgules).
# Défaut documenté : l'administrateur du Studio.
PESCE_WEB_ADMIN_EMAILS=

# Identifiant OAuth Web public Google (audience du jeton d'identité) — aucun secret client requis.
GOOGLE_OAUTH_CLIENT_ID=
