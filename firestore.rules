rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pesce Studio uses the Firebase Admin SDK from Vercel serverless functions.
    // Direct browser/client access is intentionally disabled so all writes and
    // reads go through the authenticated server-side API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
